	(uuid "4717e0c5-e2ab-49dc-90e2-def66963f50f")
	(paper "A4")
	(title_block
		(title " Two-Zone Mono Audio Amplifier with HM2410-ND Isolation")
		(date "2026-10-16")
		(rev "REV C 10-2026")
		(company "Interconnect board for XH-M562 / TPA3116D2 module")
		(comment 1 "Underwater zone uses 2 x HM2410-ND / Hammond 117K16 back-to-back on matching 16 W taps.")
		(comment 2 "C3/C4 are differential BTL filter capacitors: connect across the two speaker leads, not to GND.")
		(comment 3 "HM2411-ND transformers are chassis-mount/off-board parts; keep them in the dry enclosure.")
		(comment 4 "All speaker outputs remain floating: never bond either speaker lead to GND/chassis/earth/pool bonding.")
	)
